{
  "name": "@carecard/common-util",
  "version": "3.27.0",
  "description": "Standardized API response and utility functions for Express.js and Next.js microservices",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./logging": {
      "import": "./logging.mjs",
      "require": "./logging.js",
      "types": "./logging.d.ts"
    },
    "./postgres-routing": {
      "import": "./postgres-routing.mjs",
      "require": "./postgres-routing.js",
      "types": "./postgres-routing.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "logging.js",
    "logging.mjs",
    "logging.d.ts",
    "postgres-routing.js",
    "postgres-routing.mjs",
    "postgres-routing.d.ts",
    "src"
  ],
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CareCard-ca/pkg-common-util.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "test": "node scripts/runPackageTask.mjs test",
    "test:order": "node --test scripts/testOrder/randomizeTestOrder.test.mjs scripts/testParallel/runIndexedMochaTests.test.mjs scripts/packageTaskRunner.test.mjs scripts/canonicalTestCommand.test.mjs",
    "test:types": "node scripts/runPackageTask.mjs test:types",
    "test:coverage": "node scripts/runPackageTask.mjs test:coverage",
    "test:All": "node scripts/runPackageTask.mjs test:All",
    "validate:audits": "node scripts/runPackageTask.mjs validate:audits",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [
    "express",
    "nextjs",
    "api-response",
    "standardization",
    "utility",
    "request-context",
    "tracing"
  ],
  "author": "CareCard team",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.3",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "9.39.5",
    "express": "5.2.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "mocha": "11.7.6",
    "nyc": "18.0.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "1.9.1",
    "express": "4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "diff": "8.0.4",
    "minimatch": "10.2.6",
    "serialize-javascript": "7.0.5",
    "js-yaml": "4.3.1"
  }
}
