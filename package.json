{
  "name": "@carecard/common-util",
  "version": "3.16.0",
  "description": "Standardized API response and utility functions for Express.js and Next.js microservices",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./logging": {
      "import": "./logging.mjs",
      "require": "./logging.js",
      "types": "./logging.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "logging.js",
    "logging.mjs",
    "logging.d.ts",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CareCard-ca/pkg-common-util.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "test": "npm run test:order && node test/index.test.js",
    "test:order": "node --test scripts/testOrder/randomizeTestOrder.test.mjs scripts/testOrder/testOrderPolicy.test.mjs scripts/testParallel/runIndexedMochaTests.test.mjs scripts/testParallel/parallelTestPolicy.test.mjs",
    "test:types": "npm run test:order && tsc --noEmit && mocha --require ./scripts/testOrder/randomizeTestOrder.cjs -r ts-node/register test/types.test.mts",
    "test:coverage": "npm run test:order && tsc --noEmit && nyc node test/index.test.js",
    "test:All": "npm run test && npm run test:types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:fix": "eslint --fix",
    "lint": "eslint"
  },
  "keywords": [
    "express",
    "nextjs",
    "api-response",
    "standardization",
    "utility",
    "request-context",
    "tracing"
  ],
  "author": "CareCard team",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.3",
    "eslint": "9.39.4",
    "express": "5.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "mocha": "11.7.6",
    "nyc": "18.0.0",
    "prettier": "3.8.4",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "1.9.1",
    "express": "4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "overrides": {
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5",
    "js-yaml": "4.3.0"
  }
}
