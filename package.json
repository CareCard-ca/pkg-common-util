{
  "name": "@carecard/common-util",
  "version": "3.1.13",
  "description": "Standardized API response and utility functions for Express.js and Next.js microservices",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/CareCard-ca/pkg-common-util"
  },
  "scripts": {
    "test": "mocha --recursive",
    "test:types": "tsc --noEmit && mocha -r ts-node/register test/types.test.mts",
    "test:coverage": "tsc --noEmit && nyc mocha --recursive -r ts-node/register 'test/**/*.{js,ts}'",
    "test:All": "npm run test && npm run test:types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:fix": "eslint --fix",
    "lint": "eslint"
  },
  "keywords": [
    "express",
    "nextjs",
    "api-response",
    "standardization",
    "utility",
    "request-context",
    "tracing"
  ],
  "author": "CareCard team",
  "license": "ISC",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "1.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "25.6.2",
    "@types/express": "5.0.6",
    "express": "5.1.0",
    "husky": "9.1.7",
    "mocha": "11.7.5",
    "nyc": "18.0.0",
    "prettier": "3.8.3",
    "eslint": "9.39.4",
    "lint-staged": "17.0.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  }
}
